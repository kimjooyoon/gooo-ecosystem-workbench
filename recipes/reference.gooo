package apidocs
namespace apidocs
entity Text id "gooo://ecosystem/api-reference/text"
activity Reference(Text, Text, Text) -> Text computes `return "# " + input0 + "\n\n\x60" + input1 + "\x60\n\n" + input2 + "\n\nThis page documents the declared interface and stable type identities. It does not claim to describe runtime behavior.\n"`
activity Echo(Text) -> Text computes `return input`
bind Reference.result -> Echo.input
