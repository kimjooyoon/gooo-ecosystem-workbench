package adaptivefault
namespace adaptivefault
entity Integer id "adaptivefault://integer"
activity One(Integer) -> Integer computes "return __GOOO_BODY_HOLE_value__ + __GOOO_BODY_HOLE_bias__" assembling {
 source_fill intent "Return one for every integer." {
  hole "value"
  hole "bias"
  candidate "ratio" { fill "value" "input / input" fill "bias" "0" }
  candidate "constant" { fill "value" "1" fill "bias" "0" }
 }
 case "1" -> "1"
}
activity Main(Integer) -> Integer computes "return One(input)"
