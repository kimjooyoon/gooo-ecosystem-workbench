package retry
namespace retry
entity Integer id "gooo://retry/integer"
entity Boolean id "gooo://retry/boolean"
entity Plan id "gooo://retry/plan" fields {
    field retry id "gooo://retry/plan/retry" type boolean required one
    field delay_ms id "gooo://retry/plan/delay-ms" type integer required one
    field reason id "gooo://retry/plan/reason" type string required one
}
activity PlanRetry(Boolean, Boolean, Integer, Integer, Integer, Integer) -> Plan computes `let again = false
let delay = 0
let reason = "invalid-input"
if input2 >= 0 && input3 >= 0 && input4 >= 0 && input5 >= 0 {
    reason = "completed"
    if !input0 {
        reason = "permanent-failure"
        if input1 {
            reason = "attempt-limit"
            if input2 < input3 {
                again = true
                reason = "retry"
                delay = input5
                if input4 <= input5 - input4 { delay = input4 * 2 }
                if input4 == 0 && input5 > 0 { delay = 1 }
            }
        }
    }
}
return Plan{retry: again, delay_ms: 0, reason: "pending"}` assembling {
    choice "retry" field_value at "0" alternative "false" intent "분기에서 계산한 재시도 여부를 반환한다."
    choice "delay" field_value at "1" alternative "delay" intent "상한 안에서 계산한 대기 시간을 반환한다."
    choice "reason" field_value at "2" alternative "reason" intent "분기에서 선택한 이유를 반환한다."
    value_case "[false,true,1,3,10,100]" -> "{\"retry\":true,\"delay_ms\":20,\"reason\":\"retry\"}"
    value_case "[true,true,1,3,10,100]" -> "{\"retry\":false,\"delay_ms\":0,\"reason\":\"completed\"}"
    value_case "[false,false,1,3,10,100]" -> "{\"retry\":false,\"delay_ms\":0,\"reason\":\"permanent-failure\"}"
    value_case "[false,true,3,3,10,100]" -> "{\"retry\":false,\"delay_ms\":0,\"reason\":\"attempt-limit\"}"
    value_case "[false,true,-1,3,10,100]" -> "{\"retry\":false,\"delay_ms\":0,\"reason\":\"invalid-input\"}"
    attempts "8"
}
